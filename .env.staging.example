APP_ENV=staging
APP_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
PUBLIC_BASE_URL=https://staging-api.example.com
CORS_ORIGINS=[]

POSTGRES_DB=health_os_staging
POSTGRES_USER=health_staging
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+asyncpg://health_staging:replace-with-a-strong-database-password@postgres:5432/health_os_staging
REDIS_URL=redis://redis:6379/0

UPLOAD_DIR=/data/private/uploads
MAX_UPLOAD_BYTES=10485760
STORAGE_HOST_PATH=/srv/personal-health-staging/private
BACKUP_HOST_PATH=/srv/personal-health-staging/backups
TLS_CERT_HOST_PATH=/etc/letsencrypt/live/staging-api.example.com
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=3

AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=
AI_TEXT_MODEL=
AI_VISION_MODEL=
AI_EMBEDDING_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=60

VISION_PROVIDER=mock
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=mock-meal-v1
COACH_PROVIDER=mock
COACH_BASE_URL=
COACH_API_KEY=
COACH_MODEL=mock-coach-v1
EMBEDDING_PROVIDER=mock
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=mock-embedding-v1
LAB_OCR_PROVIDER=mock
LAB_OCR_BASE_URL=
LAB_OCR_API_KEY=
LAB_OCR_MODEL=mock-lab-ocr-v1
HEALTH_ANSWER_PROVIDER=mock
HEALTH_ANSWER_BASE_URL=
HEALTH_ANSWER_API_KEY=
HEALTH_ANSWER_MODEL=mock-health-answer-v1

PUSH_PROVIDER=mock
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_AUTH_KEY_PATH=
APNS_BUNDLE_ID=
APNS_USE_SANDBOX=true
PROACTIVE_AI_DAILY_LIMIT=2
REPORT_REGENERATION_LIMIT=3

SENTRY_DSN=
