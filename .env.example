APP_ENV=development
APP_SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql+asyncpg://health:change-me@postgres:5432/health_os
REDIS_URL=redis://redis:6379/0
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=["http://localhost:3000"]
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=10485760
AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=
AI_TEXT_MODEL=
AI_VISION_MODEL=
AI_EMBEDDING_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=60
VISION_PROVIDER=mock
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=mock-meal-v1
VISION_PROMPT_VERSION=meal_v1
VISION_TIMEOUT_SECONDS=45
VISION_MAX_ATTEMPTS=2
VISION_DAILY_LIMIT=50
VISION_MAX_PIXELS=36000000
VISION_MAX_DIMENSION=12000
VISION_ASYNC_ENABLED=false
VISION_REANALYSIS_LIMIT=3
VISION_RAW_RESPONSE_MAX_CHARS=100000
VISION_RAW_RESPONSE_RETENTION_DAYS=7
MEAL_ANALYSIS_DRAFT_TTL_HOURS=24
MEAL_IMAGE_RETENTION_DAYS=30
AI_USAGE_RETENTION_DAYS=365

POSTGRES_DB=health_os
POSTGRES_USER=health
POSTGRES_PASSWORD=change-me

